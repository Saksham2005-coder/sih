# Application
PROJECT_NAME="ReguFlow 360"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Security
SECRET_KEY="supersecret_dev_key_change_in_production_reguflow360"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration
# Default to SQLite for zero-friction local execution.
# For PostgreSQL with Docker: postgresql+psycopg2://reguflow:reguflow_secret@localhost:5432/reguflow360
DATABASE_URL="sqlite:///./reguflow.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=15728640

# Timezone & Localization
TIMEZONE="Asia/Kolkata"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Optional AI Case Brief Assistant (fallback operates offline without API key)
GEMINI_API_KEY=""
