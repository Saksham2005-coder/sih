# ==============================================================================
# ReguFlow 360 — Environment Configuration Specification
# AICTE Problem Statement 26262
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT & SIH DEMO MODE (Default)
# ------------------------------------------------------------------------------
PROJECT_NAME="ReguFlow 360"
ENVIRONMENT="development"
DEBUG=True
DEMO_MODE=True
API_V1_STR="/api"

# Development Signing Key (Permitted ONLY when ENVIRONMENT != production)
SECRET_KEY="supersecret_dev_key_change_in_production_reguflow360"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Development Database (SQLite by default; for local Postgres use 127.0.0.1:5432)
# SQLite: sqlite:///./reguflow.db
# PostgreSQL: postgresql+psycopg2://reguflow:reguflow_secret@127.0.0.1:5432/reguflow360
DATABASE_URL="sqlite:///./reguflow.db"

# Storage & Timezone
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=15728640
TIMEZONE="Asia/Kolkata"

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Optional AI Case Brief Assistant (operates deterministic rule-based fallback when empty)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. PRODUCTION DEPLOYMENT REQUIREMENTS (Fail-Closed Policy)
# ------------------------------------------------------------------------------
# In production, startup will fail closed immediately if any of the following are violated:
#   1. ENVIRONMENT must be set to "production"
#   2. DEBUG must be set to False
#   3. DEMO_MODE must be set to False
#   4. SECRET_KEY must be a unique, cryptographically random key (>= 32 chars).
#      Generate with: openssl rand -hex 32
#   5. DATABASE_URL must be a PostgreSQL connection string with secure credentials.
#      SQLite is strictly rejected in production mode.
#   6. Default development passwords ("reguflow_secret", "postgres") are rejected.
#
# Production Example:
#   ENVIRONMENT=production
#   DEBUG=False
#   DEMO_MODE=False
#   SECRET_KEY=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
#   DATABASE_URL=postgresql+psycopg2://reguflow_app:StrongProdPassword987!@db-host:5432/reguflow360_prod
